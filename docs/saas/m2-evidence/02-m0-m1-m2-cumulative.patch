+  }
+  const cartGuard = asyncHandler(async (req, res, next) => {
+    await cartOwned(req.params.id, req.auth_context.actor_id)
+    next()
+  })
+  const inputGuard = asyncHandler(async (req, res, next) => {
+    const data = req.body || {}
+    if (
+      data.additional_data ||
+      data.customer_id ||
+      data.unit_price ||
+      data.amount ||
+      data.provider_credentials
+    )
