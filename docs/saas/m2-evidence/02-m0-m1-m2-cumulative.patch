+    const da = await as(A, () => product.createProducts(data('Deep A')));
+    const db = await as(B, () => product.createProducts(data('Deep B')));
+    deepA = da; deepB = db;
+    assert.equal(da.images.length, 1); assert.equal(db.images.length, 1);
