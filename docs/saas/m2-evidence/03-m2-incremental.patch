+const signatureInput = (credentialKey, timestamp, rawBody) =>
+  Buffer.concat([
+    Buffer.from(
+      JSON.stringify([
+        "medusa-saas-callback-v1",
+        credentialKey,
+        String(timestamp),
+      ]) + "\n"
+    ),
+    rawBody,
+  ])
