+  createTenantVerifier,
+  runWithTenant,
+  TenantSecurityError,
+} = require("./tenant-context.cjs")
+const { rejectAuthority } = require("./tenant-jobs.cjs")
+const fail = (code, message) => {
+  throw new TenantSecurityError(code, message)
