+          type: error.type,
+          code: error.code,
+          name: error.name,
+          message: error.message,
+        })
+      res.status(status).json({
+        code: error.code || error.type || "M1_REQUEST_FAILED",
+        message: status === 500 ? "Request failed" : error.message,
+      })
+    })
+    await nativeApp.onApplicationStart()
+    return {
+      web,
+      nativeApp,
+      control,
+      pool,
+      m2Runtime,
+      m3Runtime,
+      m4Runtime,
+      close: async () => {
+        await pool.end()
+        await closeNative()
+      },
+    }
+  } catch (error) {
+    await pool.end()
+    if (nativeResources) await nativeResources.close()
+    throw error
+  }
+}
