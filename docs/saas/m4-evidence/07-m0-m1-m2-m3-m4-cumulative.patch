+          assert.equal(response.status, 409)
+          assert.equal((await level(A)).reserved_quantity, 0)
+          const after = (
+            await call(
+              A,
+              "GET",
+              `/store/carts/${pending.id}`,
+              null,
+              buyerA.headers
+            )
