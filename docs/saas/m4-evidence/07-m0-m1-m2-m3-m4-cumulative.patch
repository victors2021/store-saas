+          assert.equal((await level(A)).reserved_quantity, 0)
+        }
+      )
+      await check(
+        "credential rotation pins old sessions and publishes the new key only to new sessions",
+        async () => {
+          const old = await cart(A, buyerA),
+            rotation = stripe.rotate("alpha")
