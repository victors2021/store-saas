+          jwt.sign({ tenant_id: tenant.id }, contextSecret, {
+            algorithm: "HS256",
+            subject: tenant.ownerActorId,
+            issuer: "medusa-m4-callback",
+            audience: "payment-callback",
+            expiresIn: "5m",
+          })
+        )
