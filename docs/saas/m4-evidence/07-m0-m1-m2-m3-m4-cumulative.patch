diff --git a/saas/storefront/check-env-variables.js b/saas/storefront/check-env-variables.js
new file mode 100644
index 00000000..f007ea7d
--- /dev/null
+++ b/saas/storefront/check-env-variables.js
@@ -0,0 +1,41 @@
+const c = require("ansi-colors")
+
+const requiredEnvs = [
+  {
+    key: "MEDUSA_BACKEND_URL",
+    description: "The fixed server-side SaaS gateway URL.",
+  },
+  {
+    key: "SAAS_BASE_DOMAIN",
+    description: "The platform DNS base domain; the request Host selects the store.",
+  },
+]
+
+function checkEnvVariables() {
+  const missingEnvs = requiredEnvs.filter(function (env) {
+    return !process.env[env.key]
+  })
+
+  if (missingEnvs.length > 0) {
+    console.error(
+      c.red.bold("\n🚫 Error: Missing required environment variables\n")
+    )
+
+    missingEnvs.forEach(function (env) {
+      console.error(c.yellow(`  ${c.bold(env.key)}`))
+      if (env.description) {
+        console.error(c.dim(`    ${env.description}\n`))
+      }
+    })
+
+    console.error(
+      c.yellow(
+        "\nPlease set these variables in your .env file or environment before starting the application.\n"
+      )
+    )
+
+    process.exit(1)
+  }
+}
+
+module.exports = checkEnvVariables
