+          const payload = JSON.stringify(event),
+            signature = Stripe.webhooks.generateTestHeaderString({
+              payload,
+              secret: stripe.config("bravo").webhook_secret,
+            })
+          const config = (await call(B, "GET", "/admin/saas/payments")).payment
+          const result = f.ok(
+            await f.request(
+              B.hostname,
+              "POST",
