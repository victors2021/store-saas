+          title: `${tenant.slug === "alpha" ? "Alpha" : "Bravo"} Cotton Shirt`, handle: "cotton-shirt", status: "published",
+          description: "M3 tenant acceptance product", options: [{ title: "Size", values: ["One"] }],
