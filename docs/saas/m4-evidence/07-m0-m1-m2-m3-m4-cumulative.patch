diff --git a/saas/storefront/src/app/page.tsx b/saas/storefront/src/app/page.tsx
new file mode 100644
index 00000000..17033535
--- /dev/null
+++ b/saas/storefront/src/app/page.tsx
@@ -0,0 +1,11 @@
+import { listRegions } from "@lib/data/regions"
+import { redirect, notFound } from "next/navigation"
+
+export const dynamic = "force-dynamic"
+export default async function StoreRoot() {
+  const regions = await listRegions()
+  const countries = regions.flatMap((region) => region.countries?.map((country) => country.iso_2) || [])
+  const country = countries.includes("us") ? "us" : countries[0]
+  if (!country) notFound()
+  redirect(`/${country}`)
+}
