+      web.get(url,asyncHandler(async(req,res)=>{
+        if(normalizeHost(req.headers.host)!==`platform.${baseDomain}`||["x-forwarded-host","x-tenant-id","tenant-id","tenant_id"].some(k=>req.headers[k]!==undefined))
