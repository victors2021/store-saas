+        JOIN saas_control.plan_assignment p ON p.tenant_id=t.id JOIN saas_control.tenant_usage u ON u.tenant_id=t.id
+        ORDER BY t.created_at,t.id LIMIT $1 OFFSET $2`,[q.limit,q.offset])
